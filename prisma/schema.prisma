  @@map("activity_logs")
}

model ApiKey {
  id           String    @id @default(uuid())
  name         String
  keyHash      String    @unique @map("key_hash") // SHA-256 hash of API key
  maskedKey    String    @map("masked_key") // e.g. gk_live_...xxxx
  status       String    @default("active") // active, revoked, expired
  scopes       String    @default("read:all") // comma-separated scopes
  roleMapping  String    @default("admin") @map("role_mapping") // mapped role name
  expiresAt    DateTime? @map("expires_at")
  lastUsedAt   DateTime? @map("last_used_at")
  usageCount   Int       @default(0) @map("usage_count")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([keyHash])
  @@map("api_keys")
}

model Webhook {
  id          String            @id @default(uuid())
  name        String
  url         String
  secret      String            // HMAC signing secret
  status      String            @default("active") // active, disabled
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deliveries  WebhookDelivery[]
  events      WebhookEvent[]

  @@map("webhooks")
}

model WebhookEvent {
  id        String   @id @default(uuid())
  webhookId String   @map("webhook_id")
  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event     String   // e.g. user.created, payment.success
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([webhookId, event])
  @@map("webhook_events")
}

model WebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String    @map("webhook_id")
  webhook      Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payload      String    // JSON request payload
  statusCode   Int?      @map("status_code")
  responseBody String?   @map("response_body")
  duration     Int       // request latency in ms
  status       String    // success, failed
  retryCount   Int       @default(0) @map("retry_count")
  nextRetryAt  DateTime? @map("next_retry_at")
  error        String?
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([webhookId])
  @@index([status])
  @@map("webhook_deliveries")
}

model ApiVersion {
  id          String    @id @default(uuid())
  version     String    @unique // e.g. v1, v2
  status      String    @default("active") // active, deprecated, retired
  deprecatedAt DateTime? @map("deprecated_at")
  retiredAt   DateTime? @map("retired_at")
