  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  filename  String
  filepath  String
  filesize  Int
  createdAt DateTime @default(now()) @map("created_at")

  @@map("task_attachments")
}

model ScheduledJob {
  id             String       @id @default(uuid())
  name           String       @unique
  type           String       // cron, one_time
  cronExpression String?      @map("cron_expression")
  timezone       String       @default("UTC")
  status         String       @default("active") // active, paused, cancelled
  lastRun        DateTime?    @map("last_run")
  nextRun        DateTime?    @map("next_run")
  retryCount     Int          @default(0) @map("retry_count")
  maxRetries     Int          @default(3) @map("max_retries")
  executionTime  Int?         @map("execution_time") // in ms
  errorMessage   String?      @map("error_message")
  createdBy      String?      @map("created_by")
  updatedBy      String?      @map("updated_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  history        JobHistory[]

  @@map("scheduled_jobs")
}

model JobHistory {
  id            String       @id @default(uuid())
  jobId         String       @map("job_id")
  job           ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status        String       // success, failed
  executionTime Int          @map("execution_time") // in ms
  errorMessage  String?      @map("error_message")
  runAt         DateTime     @default(now()) @map("run_at")

  @@map("job_history")
}

model AutomationRule {
  id           String          @id @default(uuid())
  name         String          @unique
  event        String          // e.g. subscription_expired, project_inactive, etc.
  conditions   String          // JSON string
  actions      String          // JSON string
  priority     Int             @default(0)
  status       String          @default("active") // active, inactive
  createdBy    String?         @map("created_by")
  updatedBy    String?         @map("updated_by")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  logs         AutomationLog[]

  @@map("automation_rules")
}

model AutomationLog {
  id               String         @id @default(uuid())
  ruleId           String         @map("rule_id")
  rule             AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  triggerEntityId  String?        @map("trigger_entity_id")
  status           String         // success, failed
  errorMessage     String?        @map("error_message")
  executionDetails String?        @map("execution_details") // JSON string
  createdAt        DateTime       @default(now()) @map("created_at")

  @@map("automation_logs")
}

model CronExecution {
  id            String   @id @default(uuid())
  jobName       String   @map("job_name")
  status        String   // success, failed
  executionTime Int      @map("execution_time")
  errorMessage  String?  @map("error_message")
  executedAt    DateTime @default(now()) @map("executed_at")

  @@map("cron_executions")
}

// ==========================================
// SYSTEM MONITORING & DEVOPS
// ==========================================

model ApiRequestLog {
  id           String   @id @default(uuid())
  method       String   // GET, POST, PUT, PATCH, DELETE
  url          String
  statusCode   Int      @map("status_code")
  responseTime Int      @map("response_time") // in ms
  userId       String?  @map("user_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([statusCode])
  @@index([method])
  @@map("api_request_logs")
}

model LoginAttempt {
  id         String   @id @default(uuid())
  email      String
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  success    Boolean  @default(false)
  failReason String?  @map("fail_reason")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@index([success])
  @@map("login_attempts")
}

model SystemAlert {
  id             String    @id @default(uuid())
  type           String    // api_error_rate, failed_jobs, db_unavailable, storage_full, failed_logins, backup_failed, scheduler_stopped, queue_overflow
  severity       String    @default("warning") // info, warning, critical
  title          String
  message        String
  status         String    @default("active") // active, acknowledged, resolved
  acknowledgedBy String?   @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at")
  resolvedBy     String?   @map("resolved_by")
  resolvedAt     DateTime? @map("resolved_at")
  metadata       String?   // JSON string for extra context
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([createdAt])
  @@map("system_alerts")
}
