  category  String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id          String     @id @default(uuid())
  actorId     String?    @map("actor_id")
  actor       AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String     // create, update, delete, login, logout
  entity      String     // users, freelancers, projects, etc.
  entityId    String?    @map("entity_id")
  oldValue    String?    @map("old_value") @db.LongText  // JSON snapshot BEFORE mutation
  newValue    String?    @map("new_value") @db.LongText  // JSON snapshot AFTER mutation
  diff        String?    @db.LongText // Summary of changed fields only
  ipAddress   String?    @map("ip_address")
  userAgent   String?    @map("user_agent")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("audit_logs")
}

model ActivityLog {
