  updatedAt  DateTime @updatedAt @map("updated_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "reviews_project_id_fkey")
  @@index([revieweeId], map: "reviews_reviewee_id_fkey")
  @@index([reviewerId], map: "reviews_reviewer_id_fkey")
  @@map("reviews")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  author    String
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "task_comments_task_id_fkey")
  @@map("task_comments")
}

model TaskAttachment {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  filename  String
  filepath  String
  filesize  Int
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "task_attachments_task_id_fkey")
  @@map("task_attachments")
}

model ScheduledJob {
  id             String       @id @default(uuid())
  name           String       @unique
  type           String
  cronExpression String?      @map("cron_expression")
  timezone       String       @default("UTC")
  status         String       @default("active")
  lastRun        DateTime?    @map("last_run")
  nextRun        DateTime?    @map("next_run")
  retryCount     Int          @default(0) @map("retry_count")
  maxRetries     Int          @default(3) @map("max_retries")
  executionTime  Int?         @map("execution_time")
  errorMessage   String?      @map("error_message")
  createdBy      String?      @map("created_by")
  updatedBy      String?      @map("updated_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  history        JobHistory[]

  @@map("scheduled_jobs")
}

model JobHistory {
  id            String       @id @default(uuid())
  jobId         String       @map("job_id")
  status        String
  executionTime Int          @map("execution_time")
  errorMessage  String?      @map("error_message")
  runAt         DateTime     @default(now()) @map("run_at")
  job           ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId], map: "job_history_job_id_fkey")
  @@map("job_history")
}

model AutomationRule {
  id         String          @id @default(uuid())
  name       String          @unique
  event      String
  conditions String
  actions    String
  priority   Int             @default(0)
  status     String          @default("active")
  createdBy  String?         @map("created_by")
  updatedBy  String?         @map("updated_by")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  logs       AutomationLog[]

  @@map("automation_rules")
}

model AutomationLog {
  id               String         @id @default(uuid())
  ruleId           String         @map("rule_id")
  triggerEntityId  String?        @map("trigger_entity_id")
  status           String
  errorMessage     String?        @map("error_message")
  executionDetails String?        @map("execution_details")
  createdAt        DateTime       @default(now()) @map("created_at")
  rule             AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId], map: "automation_logs_rule_id_fkey")
  @@map("automation_logs")
}

model CronExecution {
  id            String   @id @default(uuid())
  jobName       String   @map("job_name")
  status        String
  executionTime Int      @map("execution_time")
  errorMessage  String?  @map("error_message")
  executedAt    DateTime @default(now()) @map("executed_at")

  @@map("cron_executions")
}

model ApiRequestLog {
  id           String   @id @default(uuid())
  method       String
  url          String
  statusCode   Int      @map("status_code")
  responseTime Int      @map("response_time")
  userId       String?  @map("user_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent") @db.Text
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([statusCode])
  @@index([method])
  @@map("api_request_logs")
}

model LoginAttempt {
  id         String   @id @default(uuid())
  email      String
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  success    Boolean  @default(false)
  failReason String?  @map("fail_reason")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@index([success])
  @@map("login_attempts")
}

model SystemAlert {
  id             String    @id @default(uuid())
  type           String
  severity       String    @default("warning")
  title          String
  message        String
  status         String    @default("active")
  acknowledgedBy String?   @map("acknowledged_by")
  acknowledgedAt DateTime? @map("acknowledged_at")
  resolvedBy     String?   @map("resolved_by")
  resolvedAt     DateTime? @map("resolved_at")
  metadata       String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([createdAt])
  @@map("system_alerts")
}

model InsightReport {
  id          String    @id @default(uuid())
  name        String
  category    String
  format      String    @default("PDF")
  createdBy   String    @default("Admin") @map("created_by")
  schedule    String?
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("insight_reports")
}

model AnalyticsDashboard {
  id            String    @id @default(uuid())
  name          String
  category      String    @default("General")
  queryModel    String    @map("query_model")
  columnsConfig String?   @map("columns_config")
  creator       String    @default("Admin")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@map("analytics_dashboards")
}

