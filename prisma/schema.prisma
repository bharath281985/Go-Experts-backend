// Unified Prisma Schema for GoExperts (Mobile API + Admin/Web Backend)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  fullName      String         @map("full_name")
  avatarUrl     String?        @map("avatar_url")
  status        String         @default("active")
  roleId        String         @map("role_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  activityLogs  ActivityLog[]
  role          Role           @relation(fields: [roleId], references: [id])
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  sessions      Session[]

  @@index([roleId], map: "admin_users_role_id_fkey")
  @@map("admin_users")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  status          String           @default("active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  adminUsers      AdminUser[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  action          String
  module          String
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@unique([action, module])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_fkey")
  @@map("role_permissions")
}

model Session {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent") @db.Text
  token       String    @db.VarChar(1024)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId], map: "sessions_admin_user_id_fkey")
  @@map("sessions")
}

model RefreshToken {
  id          String    @id @default(uuid())
  adminUserId String    @map("admin_user_id")
  token       String    @unique @db.VarChar(1024)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId], map: "refresh_tokens_admin_user_id_fkey")
  @@map("refresh_tokens")
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  password                String                  @default("")
  fullName                String                  @map("full_name")
  avatarUrl               String?                 @map("avatar_url")
  role                    String
  status                  String                  @default("active")
  isVerified              Boolean                 @default(false) @map("is_verified")
  verified                Boolean                 @default(false)
  phone                   String?
  country                 String?
  city                    String?
  bio                     String?
  referralCode            String?                 @unique @map("referral_code")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  deletedAt               DateTime?               @map("deleted_at")
  advertisements          Advertisement[]
  clientProfile           ClientProfile?
  clientContracts         Contract[]              @relation("ClientContracts")
  freelancerContracts     Contract[]              @relation("FreelancerContracts")
  couponUsages            CouponUsage[]
  deviceTokens            DeviceToken[]
  featuredServices        FeaturedService[]
  founderProfile          FounderProfile?
  freelancerProfile       FreelancerProfile?
  investorProfile         InvestorProfile?
  invoices                Invoice[]
  notificationLogs        NotificationLog[]
  notificationPreferences NotificationPreference?
  notifications           Notification[]
  payments                Payment[]
  proposals               Proposal[]
  referralReceived        Referral?               @relation("Referee")
  referralsGiven          Referral[]              @relation("Referrer")
  reviewsReceived         Review[]                @relation("Reviewee")
  reviewsWritten          Review[]                @relation("Reviewer")
  subscriptionHistories   SubscriptionHistory[]
  subscriptions           Subscription[]
  walletRewards           WalletReward[]
  wallet                  Wallet?
  trialEndsAt    DateTime? @map("trial_ends_at")
  registrationData Json?   @map("registration_data")

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model FreelancerProfile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  skills     String?
  hourlyRate Float?   @map("hourly_rate")
  rating     Float?   @default(5)
  experience String?  @map("experience_level")
  industry   String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationJson String? @map("verification_json") @db.Text
  portfolioJson String? @map("portfolio_json") @db.Text

  @@map("freelancer_profiles")
}

model ClientProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  company        String?
  industry       String?
  totalSpend     Float?   @default(0) @map("total_spend")
  projectsPosted Int      @default(0) @map("projects_posted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model InvestorProfile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  firm       String?
  ticketMin  Float?   @map("ticket_min")
  ticketMax  Float?   @map("ticket_max")
  focusAreas String?  @map("focus_areas")
  deals      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

model FounderProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  startupName String?  @map("startup_name")
  industry    String?
  stage       String?
  raised      Float?   @default(0)
  teamSize    Int      @default(1) @map("team_size")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("founder_profiles")
}

model Project {
  id              String      @id @default(uuid())
  title           String
  client          String
  freelancer      String?
  budget          Float
  budgetMin       Float?      @map("budget_min")
  budgetMax       Float?      @map("budget_max")
  category        String
  technology      String
  timeline        String?
  description     String?     @db.Text
  workMode        String?     @map("work_mode")
  experienceLevel String?     @map("experience_level")
  attachments     String?     @db.Text
  shareCount      Int?         @default(0) @map("share_count")
  status          String      @default("open")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  deletedAt       DateTime?   @map("deleted_at")
  contracts       Contract[]
  milestones      Milestone[]
  proposals       Proposal[]
  reviews         Review[]
  tasks           Task[]

  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("projects")
}

model Task {
  id          String           @id @default(uuid())
  projectId   String           @map("project_id")
  title       String?
  assignedTo  String?          @map("assigned_to")
  priority    String           @default("Medium")
  progress    Int              @default(0)
  status      String           @default("todo")
  dueDate     String?          @map("due_date")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  attachments TaskAttachment[]
  checklists  TaskChecklist[]
  comments    TaskComment[]
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeLogs    TimeLog[]

  @@index([projectId], map: "tasks_project_id_fkey")
  @@map("tasks")
}

model TaskChecklist {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  title     String
  status    String   @default("Pending")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "task_checklists_task_id_fkey")
  @@map("task_checklists")
}

model Milestone {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  title     String
  status    String   @default("Pending")
  dueDate   String?  @map("due_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId], map: "milestones_project_id_fkey")
  @@map("milestones")
}

model TimeLog {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  worker    String
  hours     String
  taskDesc  String   @map("task_desc")
  date      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "time_logs_task_id_fkey")
  @@map("time_logs")
}

model StartupIdea {
  id                  String    @id @default(uuid())
  startup             String
  founder             String
  industry            String
  category            String
  stage               String
  funding             Float
  equity              Float
  visibility          String    @default("Public")
  pitchDeck           String?   @map("pitch_deck")
  businessPlan        String?   @map("business_plan") @db.Text
  logo                String?
  coverUrl            String?   @map("cover_url")
  status              String    @default("active")
  views               Int       @default(0)
  interestedInvestors Int       @default(0) @map("interested_investors")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  @@index([status])
  @@index([industry])
  @@index([createdAt])
  @@map("startup_ideas")
}

model Investment {
  id          String    @id @default(uuid())
  investor    String
  startup     String
  offer       Float
  equity      Float
  meetingDate String?   @map("meeting_date")
  docs        String?   @default("View folder")
  status      String    @default("Pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([status])
  @@index([createdAt])
  @@map("investments")
}

model Meeting {
  id          String    @id @default(uuid())
  founder     String
  investor    String
  date        String
  time        String
  duration    Int?      @default(45)
  mode        String    @default("Online")
  status      String    @default("Scheduled")
  createdBy   String?   @map("created_by")
  meetingLink String?   @map("meeting_link")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("meetings")
}

model Conversation {
  id        String    @id @default(uuid())
  name      String
  role      String
  msg       String?
  time      String?
  unread    Int       @default(0)
  online    Boolean   @default(false)
  typing    Boolean   @default(false)
  avatar    String?
  userA     String?   @map("user_a")
  userB     String?   @map("user_b")
  projectId String?   @map("project_id")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  messages  Message[]

  @@index([userA])
  @@index([userB])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  from           String
  senderId       String?      @map("sender_id")
  text           String
  time           String
  readAt         DateTime?    @map("read_at")
  attachmentUrl  String?      @map("attachment_url") @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId], map: "messages_conversation_id_fkey")
  @@map("messages")
}

model Subscription {
  id                 String                    @id @default(uuid())
  userId             String                    @map("user_id")
  planId             String                    @map("plan_id")
  startDate          DateTime                  @default(now()) @map("start_date")
  endDate            DateTime                  @map("end_date")
  status             String                    @default("active")
  autoRenew          Boolean                   @default(true) @map("auto_renew")
  cancelledAt        DateTime?                 @map("cancelled_at")
  cancellationReason String?                   @map("cancellation_reason")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  invoices           Invoice[]
  payments           Payment[]
  transactions       SubscriptionTransaction[]
  usages             SubscriptionUsage[]
  plan               SubscriptionPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@index([planId], map: "subscriptions_plan_id_fkey")
  @@index([userId], map: "subscriptions_user_id_fkey")
  @@map("subscriptions")
}

model SubscriptionFeature {
  id           String           @id @default(uuid())
  planId       String           @map("plan_id")
  featureKey   String           @map("feature_key")
  featureValue String?          @map("feature_value")
  limit        Int?
  createdAt    DateTime         @default(now()) @map("created_at")
  plan         SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId], map: "subscription_features_plan_id_fkey")
  @@map("subscription_features")
}

model SubscriptionUsage {
  id             String       @id @default(uuid())
  subscriptionId String       @map("subscription_id")
  featureKey     String       @map("feature_key")
  used           Int          @default(0)
  lastUsedAt     DateTime?    @map("last_used_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, featureKey])
  @@map("subscription_usage")
}

model SubscriptionHistory {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  planId    String           @map("plan_id")
  action    String
  metadata  String?
  createdAt DateTime         @default(now()) @map("created_at")
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId], map: "subscription_history_plan_id_fkey")
  @@index([userId], map: "subscription_history_user_id_fkey")
  @@map("subscription_history")
}

model SubscriptionTransaction {
  id             String       @id @default(uuid())
  subscriptionId String       @map("subscription_id")
  type           String
  amount         Float
  currency       String       @default("INR")
  gateway        String?
  transactionRef String?      @map("transaction_ref")
  status         String       @default("success")
  createdAt      DateTime     @default(now()) @map("created_at")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId], map: "subscription_transactions_subscription_id_fkey")
  @@map("subscription_transactions")
}

model Payment {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  subscriptionId String?         @map("subscription_id")
  gateway        String
  amount         Float
  currency       String          @default("INR")
  transactionId  String?         @unique @map("transaction_id")
  status         String          @default("pending")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  refunds        PaymentRefund[]
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@index([subscriptionId], map: "payments_subscription_id_fkey")
  @@index([userId], map: "payments_user_id_fkey")
  @@map("payments")
}

model PaymentRefund {
  id          String    @id @default(uuid())
  paymentId   String    @map("payment_id")
  amount      Float
  reason      String?
  status      String    @default("pending")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId], map: "payment_refunds_payment_id_fkey")
  @@map("payment_refunds")
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique @map("user_id")
  balance      Float               @default(0)
  currency     String              @default("INR")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  bonuses      WalletBonus[]
  transactions WalletTransaction[]
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id           String   @id @default(uuid())
  walletId     String   @map("wallet_id")
  type         String
  amount       Float
  direction    String
  description  String?
  balanceAfter Float    @map("balance_after")
  status       String?   @default("completed")
  createdAt    DateTime @default(now()) @map("created_at")
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId], map: "wallet_transactions_wallet_id_fkey")
  @@map("wallet_transactions")
}

model WalletBonus {
  id        String    @id @default(uuid())
  walletId  String    @map("wallet_id")
  amount    Float
  reason    String?
  expiresAt DateTime? @map("expires_at")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  wallet    Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId], map: "wallet_bonuses_wallet_id_fkey")
  @@map("wallet_bonuses")
}

model WalletReward {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Float
  points    Int      @default(0)
  reason    String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "wallet_rewards_user_id_fkey")
  @@map("wallet_rewards")
}

model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String   @map("coupon_id")
  userId         String   @map("user_id")
  discountAmount Float    @map("discount_amount")
  createdAt      DateTime @default(now()) @map("created_at")
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId], map: "coupon_usage_coupon_id_fkey")
  @@index([userId], map: "coupon_usage_user_id_fkey")
  @@map("coupon_usage")
}

model Referral {
  id         String           @id @default(uuid())
  referrerId String           @map("referrer_id")
  refereeId  String           @unique @map("referee_id")
  link       String?
  qrCode     String?          @map("qr_code")
  status     String           @default("pending")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  rewards    ReferralReward[]
  referee    User             @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  referrer   User             @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId], map: "referrals_referrer_id_fkey")
  @@map("referrals")
}

model ReferralReward {
  id         String   @id @default(uuid())
  referralId String   @map("referral_id")
  points     Int      @default(0)
  amount     Float    @default(0)
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId], map: "referral_rewards_referral_id_fkey")
  @@map("referral_rewards")
}

model AdvertisementPlan {
  id             String          @id @default(uuid())
  name           String
  duration       String
  price          Float
  clicksLimit    Int             @map("clicks_limit")
  viewsLimit     Int             @map("views_limit")
  placement      String
  status         String          @default("active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  advertisements Advertisement[]

  @@map("advertisement_plans")
}

model Advertisement {
  id          String            @id @default(uuid())
  planId      String            @map("plan_id")
  userId      String            @map("user_id")
  title       String
  bannerUrl   String            @map("banner_url")
  targetUrl   String            @map("target_url")
  clicksCount Int               @default(0) @map("clicks_count")
  viewsCount  Int               @default(0) @map("views_count")
  status      String            @default("pending")
  startDate   DateTime?         @map("start_date")
  endDate     DateTime?         @map("end_date")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  plan        AdvertisementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([planId], map: "advertisements_plan_id_fkey")
  @@index([userId], map: "advertisements_user_id_fkey")
  @@map("advertisements")
}

model FeaturedService {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  planName   String   @map("plan_name")
  price      Float
  startDate  DateTime @default(now()) @map("start_date")
  endDate    DateTime @map("end_date")
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "featured_services_user_id_fkey")
